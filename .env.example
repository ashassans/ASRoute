# ==============================================================================
# AS ROUTER — Environment Variables Configuration
# ==============================================================================

# 1. APP_URL (Required for Deployment):
# The public URL where this app is hosted (e.g., https://your-router.up.railway.app or http://localhost:3000)
APP_URL="http://localhost:3000"

# 2. PORT (Optional):
# Port on which the server listens. Most cloud providers (Railway, Render, Cloud Run) set this automatically.
PORT=3000

# 3. BETTER_AUTH_SECRET (Required):
# A 32+ character random secret string used to sign auth cookies and encrypt your upstream API keys in the DB.
# Generate one with: openssl rand -hex 32
BETTER_AUTH_SECRET="asr_secret_8f4b2e9d7c1a6f0e3b5d8c2a9e1f4b7d5c8a2e6f"

# 4. BETTER_AUTH_URL (Optional):
# Usually identical to APP_URL.
BETTER_AUTH_URL="http://localhost:3000"

# 5. DATABASE_URL (Optional):
# If empty, AS Router will use the fast built-in local database (PGlite) automatically!
# When using Neon: paste your Neon PostgreSQL connection string:
# e.g. postgresql://user:pass@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=""

# 6. GOOGLE_CLIENT_ID & GOOGLE_CLIENT_SECRET (Optional):
# For "Sign in with Google / Gmail" on the login screen.
# Get them from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs.
# Redirect URI: https://your-domain.com/api/auth/callback/google (or http://localhost:3000/api/auth/callback/google)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 7. GEMINI_API_KEY (Optional):
# If provided, AS Router will automatically create a built-in "Server Gemini" connection for you.
# You can also just add Gemini keys inside the Web UI later.
GEMINI_API_KEY=""
